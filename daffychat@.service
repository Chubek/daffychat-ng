[Unit]
Description=DaffyChat per-user instance for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/usr/share/daffychat
ExecStart=/bin/sh -lc '/usr/bin/daffychat-server --config "$HOME/.daffychat/Daffychat.config"'
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
