[Unit]
Description=DaffyChat per-user instance for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/usr/share/daffychat
ExecStart=/usr/bin/daffychat-server --config /etc/daffychat/daffychat.conf
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
