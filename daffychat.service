[Unit]
Description=DaffyChat minimal voice-chat signaling server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/usr/share/daffychat
EnvironmentFile=-/etc/default/daffychat
ExecStart=/usr/bin/daffychat-server --host ${DAFFYCHAT_HOST:-0.0.0.0} --port ${DAFFYCHAT_PORT:-8080} --static-dir /usr/share/daffychat --password ${DAFFYCHAT_PASSWORD:-changeme} --stun-url ${DAFFYCHAT_STUN_URL:-stun:stun.l.google.com:19302} --turn-url ${DAFFYCHAT_TURN_URL:-} --turn-username ${DAFFYCHAT_TURN_USERNAME:-} --turn-password ${DAFFYCHAT_TURN_PASSWORD:-}
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
